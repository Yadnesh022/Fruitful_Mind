# =================================================================
# Fruitful Mind - Environment Variables Configuration
# =================================================================

# 1. Contact Form Endpoint (Formspree, Web3Forms, Getform, or Formkeep)
# Example Formspree: https://formspree.io/f/xanywqpo
# Example Web3Forms: https://api.web3forms.com/submit
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# 2. Newsletter Subscription Endpoint (Formspree or Mailchimp webhook)
VITE_NEWSLETTER_ENDPOINT=https://formspree.io/f/your_newsletter_id

# 3. Optional Calendly / Cal.com Direct Booking Link
# Leave blank to use direct WhatsApp booking
VITE_CALENDLY_URL=

# 4. Privacy-Friendly Analytics (Plausible or Google Analytics 4)
# Example: G-XXXXXXXXXX
VITE_GA_ID=
